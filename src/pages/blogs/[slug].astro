---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blogs', (p) => import.meta.env.DEV || !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={post.data.title} description={post.data.description} current="Blogs">
  <header class="post-head">
    <a class="crumb" href={u('/#blogs')}>Blogs</a>
    <div>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
      <p class="meta">
        <span>Kevin Li</span>
        {post.data.draft && <span>Draft</span>}
        {post.data.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </p>
    </div>
  </header>
  <div class="post-body">
    {toc.length > 0 ? (
      <nav class="toc" aria-label="Contents">
        <p>Contents</p>
        <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </nav>
    ) : <div />}
    <article class="prose"><Content /></article>
  </div>
</Base>
