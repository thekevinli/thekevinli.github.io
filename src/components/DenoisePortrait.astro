---
interface Props { src: string; alt: string; caption: string }
const { src, alt, caption } = Astro.props;
---
<figure class="portrait">
  <div class="portrait-frame">
    <img src={src} alt={alt} width="560" height="560" fetchpriority="high" />
    <canvas aria-hidden="true" data-denoise={src} width="560" height="560"></canvas>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<script>
  // Flow matching on the portrait: x_t = (1 - t)·x0 + t·ε, linear schedule, Euler steps from t = 1 to 0.
  const STEPS = 40, DURATION = 1000, CELLS = 120;

  function mulberry32(seed: number) {
    let s = seed >>> 0;
    return () => {
      s = (s + 0x6D2B79F5) >>> 0;
      let t = s;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function gaussian(n: number, seed: number) {
    const rnd = mulberry32(seed), out = new Float32Array(n);
    for (let i = 0; i < n; i += 2) {
      const u = Math.max(rnd(), 1e-9), v = rnd(), r = Math.sqrt(-2 * Math.log(u));
      out[i] = r * Math.cos(2 * Math.PI * v);
      if (i + 1 < n) out[i + 1] = r * Math.sin(2 * Math.PI * v);
    }
    return out;
  }

  function run(canvas: HTMLCanvasElement, img: HTMLImageElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const clear = () => ctx.clearRect(0, 0, canvas.width, canvas.height);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return clear();

    // Square from the frame's width: Safari can report the canvas's default 2:1 size before layout settles.
    const dpr = Math.min(2, devicePixelRatio || 1), size = (canvas.parentElement as HTMLElement).getBoundingClientRect().width || 280;
    canvas.width = canvas.height = Math.round(size * dpr);
    const gw = Math.min(CELLS, Math.round(size / 2)), gh = gw, n = gw * gh;

    // Latent grid: the photo, center-cropped like object-fit: cover.
    const grid = document.createElement('canvas');
    grid.width = gw; grid.height = gh;
    const g = grid.getContext('2d', { willReadFrequently: true })!;
    const side = Math.min(img.naturalWidth, img.naturalHeight);
    g.drawImage(img, (img.naturalWidth - side) / 2, (img.naturalHeight - side) / 2, side, side, 0, 0, gw, gh);
    let px: Uint8ClampedArray;
    try { px = g.getImageData(0, 0, gw, gh).data; } catch { return clear(); }

    const x0 = new Float32Array(n * 3);
    for (let i = 0; i < n; i++) for (let c = 0; c < 3; c++) x0[i * 3 + c] = px[i * 4 + c] / 127.5 - 1;
    const eps = gaussian(n * 3, 423);
    const out = g.createImageData(gw, gh);
    ctx.imageSmoothingEnabled = false;

    const draw = (t: number) => {
      for (let i = 0; i < n; i++) {
        for (let c = 0; c < 3; c++) out.data[i * 4 + c] = ((1 - t) * x0[i * 3 + c] + t * eps[i * 3 + c] + 1) * 127.5;
        out.data[i * 4 + 3] = 255;
      }
      g.putImageData(out, 0, 0);
      ctx.drawImage(grid, 0, 0, canvas.width, canvas.height);
    };

    const dt = DURATION / STEPS;
    let k = 0, last = 0;
    draw(1);
    const tick = (now: number) => {
      if (!last) last = now;
      if (now - last >= dt) { last = now; k++; draw(1 - k / STEPS); }
      if (k < STEPS) requestAnimationFrame(tick);
      else setTimeout(clear, 80);
    };
    requestAnimationFrame(tick);
  }

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-denoise]').forEach((canvas) => {
    const img = canvas.previousElementSibling as HTMLImageElement;
    if (img.complete && img.naturalWidth) run(canvas, img);
    else img.addEventListener('load', () => run(canvas, img), { once: true });
  });
</script>
